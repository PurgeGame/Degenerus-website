# Shared navigation and artwork can be reused between visits. Unversioned
# files still refresh promptly; fingerprinted stylesheets override this below.
/shared/*
  Cache-Control: public, max-age=60, must-revalidate

# The lesson controller and its state/renderer modules change together.
# Revalidate the entire graph so returning players cannot mix old exports
# with a newly published controller and get stuck on the loading screen.
/learn/tutorial/*
  Cache-Control: no-cache, must-revalidate

# Vendored font files are immutable (versioned filenames). Cloudflare MERGES
# same-name headers across matching rules (verified live: the /shared/*
# no-store landed in the same Cache-Control as this rule's value, and
# no-store wins in browsers) — so DETACH the inherited header first with the
# `!` syntax, then set the long-cache value.
/shared/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=604800, immutable

# App ES modules had NO rule here, so they fell back to the 4h default
# (max-age=14400). That bit on 2026-08-05: the RPC endpoint in
# chain-config.sepolia.js was corrected at origin, but Cloudflare kept serving
# the previous module to browsers — and because the edge cache key IGNORES the
# query string, a `?cachebust=` import still returned the stale copy. Chain
# config and contract addresses live in these files, so a redeploy that doesn't
# reach clients is a correctness problem, not just a staleness one.
# 60s + must-revalidate keeps repeat loads cheap (304 on ETag) while letting a
# publish land within a minute.
/app/app/*
  Cache-Control: public, max-age=60, must-revalidate

/app/components/*
  Cache-Control: public, max-age=60, must-revalidate

# Chain projections and their generated schema must refresh with app code.
/app/chain/*
  Cache-Control: public, max-age=60, must-revalidate

# app-player-funds-dialog and vrf-donation share a named-export ABI. The
# general 60s freshness window can pair a newly revalidated importer with the
# previous dependency revision during a deploy, which fails the whole dynamic
# import before the dialog mounts. Retain conditional caching, but revalidate
# this ABI-bearing dependency on every new document load.
/app/app/vrf-donation.js
  ! Cache-Control
  Cache-Control: no-cache, must-revalidate

# Always check entry HTML for updates, while allowing ETag/304 reuse of its
# body. A fresh document discovers newly fingerprinted styles and libraries.
/app
  Cache-Control: no-cache, must-revalidate

/app/
  Cache-Control: no-cache, must-revalidate

/app/index.html
  Cache-Control: no-cache, must-revalidate

# Unversioned stylesheets and vendor URLs retain a short freshness window.
# The publisher points app consumers at content-hashed copies with the
# immutable policy below. Within max-age a normal visit needs no HTTP request;
# after expiry, ETag revalidation can return a small 304 response.
/app/styles/*
  Cache-Control: public, max-age=60, must-revalidate

/app/vendor/*
  Cache-Control: public, max-age=60, must-revalidate

# Media never change in place — the -vNN filename suffixes are the bust
# mechanism (v9, v39, …), so a stale-art window is bounded by the next rename.
# Without this rule every badge SVG and card PNG revalidated on every load:
# a cold load was measured issuing ~274 SVG requests against 33 distinct files.
/app/assets/*
  Cache-Control: public, max-age=604800

# The Discord roster is the one file under /app/assets/ that is NOT versioned
# by filename — db/build-discord-roster.mjs rewrites it in place whenever a
# player links an account. The 7-day rule above would hide a new link for a
# week, so detach the inherited header first (Cloudflare MERGES same-name
# headers across matching rules; see the /shared/fonts/* note) and give it the
# same 60s + revalidate window the app modules use.
/app/assets/discord-roster.json
  ! Cache-Control
  Cache-Control: public, max-age=60, must-revalidate

# The daily-drawing board silkscreen carries the live GAME address in its "SN" legend and is
# rewritten IN PLACE by db/sync-deployment.mjs on every new run, the same trap as the roster
# above: under the 7-day rule the published board kept run #59's serial on run #65.
/app/assets/jackpot/daily-drawing-board-silkscreen-v3.svg
  ! Cache-Control
  Cache-Control: public, max-age=60, must-revalidate

/app/sounds/*
  Cache-Control: public, max-age=604800

# Trait badge art is frozen by the contract's trait topology; the app also
# ships every badge in one versioned bundle (/app/assets/badge-bundle-vN.json,
# built by db/build-badge-bundle.mjs), so these per-file lanes mostly serve
# first-paint badges and non-app pages.
/badges-circular/*
  Cache-Control: public, max-age=604800

/symbols/*
  Cache-Control: public, max-age=604800

# Two-widget presentation assets
/app/two-widget-hub/*
  Cache-Control: public, max-age=60, must-revalidate

# Generated by db/cache-publish-assets.mjs, never authored or edited in place.
# Content hashes live in the PATH (the edge can ignore query-string revisions).
# Detach the short-lived parent policy: matching Cloudflare rules are additive.
/app/vendor/cache-*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/app/styles/cache-*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/shared/cache-*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Content-addressed copies of the app's ES modules, made by db/hash-publish-modules.mjs. The
# entry HTML (no-cache) carries the import map that points every importer at them, so a
# returning player re-requests no module until a publish changes it. Every directory that
# holds a reachable module needs its own rule: a missing one silently falls back to the
# 60-second policy above (still correct, just not cached).
/app/cache-*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/app/app/cache-*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/app/chain/cache-*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/app/chain/generated/cache-*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/app/components/cache-*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/app/craps/cache-*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/app/two-widget-hub/cache-*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/app/viewer/cache-*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Hub artwork is versioned by filename (-v22, -w640) and the number fonts never change in
# place (rename to replace one), so they take the /app/assets/* policy instead of
# revalidating every minute under /app/two-widget-hub/*.
/app/two-widget-hub/art/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

/app/two-widget-hub/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

