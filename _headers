# Site-wide security baseline (2026-08-14 launch-readiness round). Additive
# header names only — these never collide with the Cache-Control rules below.
# HSTS starts conservative: 30 days, no includeSubDomains (api.degener.us is a
# separate host), no preload. Lengthen after it has soaked.
/*
  Strict-Transport-Security: max-age=2592000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# CSP ENFORCING since 2026-08-15, after a full report-only pass (cold load,
# every panel, replay/reveal overlays, settings, referrals, and the live
# WalletConnect QR modal — 878-request esm.sh SDK graph + relay + web3modal)
# surfaced exactly three missing origins, all added below.
# Origins: publicnode/base.org = chain RPC (MAINNET CUTOVER: add the mainnet
# RPC hosts here); fly.dev = DB API; api.degener.us = session server; esm.sh =
# lazy WalletConnect SDK; walletconnect/web3modal = WC relay, config, verify
# iframe, wallet icons; discord CDN = avatars; blob: = the badge bundle store;
# cloudflareinsights = the zone's auto-injected Web Analytics beacon (script)
# and its /cdn-cgi/rum POST target (connect). Google Fonts origins were
# dropped 2026-08-15 when Inter moved to self-hosted /shared/fonts/.
/app/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://degenerus-db.fly.dev https://api.degener.us https://base-sepolia-rpc.publicnode.com https://sepolia.base.org https://esm.sh https://api.web3modal.org https://pulse.walletconnect.org https://cloudflareinsights.com wss://relay.walletconnect.com wss://relay.walletconnect.org; img-src 'self' data: blob: https://cdn.discordapp.com https://api.web3modal.org https://imagedelivery.net; media-src 'self'; font-src 'self' data:; worker-src 'self' blob:; frame-src 'self' https://verify.walletconnect.org https://verify.walletconnect.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

/index.html
  Cache-Control: no-store

/
  Cache-Control: no-store

/degenerette
  Cache-Control: no-store

/degenerette/
  Cache-Control: no-store

/degenerette/index.html
  Cache-Control: no-store

/degenerette/assets/*
  Cache-Control: public, max-age=31536000, immutable

/lootbox
  Cache-Control: no-store

/lootbox/
  Cache-Control: no-store

/lootbox/index.html
  Cache-Control: no-store

/whitepaper
  Cache-Control: no-store

/whitepaper/
  Cache-Control: no-store

/whitepaper/index.html
  Cache-Control: no-store

/beta
  Cache-Control: no-store

/beta/
  Cache-Control: no-store

/beta/index.html
  Cache-Control: no-store

/shared/*
  Cache-Control: no-store

# Vendored font files are immutable (versioned filenames). Cloudflare MERGES
# same-name headers across matching rules (verified live: the /shared/*
# no-store landed in the same Cache-Control as this rule's value, and
# no-store wins in browsers) — so DETACH the inherited header first with the
# `!` syntax, then set the long-cache value.
/shared/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=604800, immutable

# App ES modules had NO rule here, so they fell back to the 4h default
# (max-age=14400). That bit on 2026-08-05: the RPC endpoint in
# chain-config.sepolia.js was corrected at origin, but Cloudflare kept serving
# the previous module to browsers — and because the edge cache key IGNORES the
# query string, a `?cachebust=` import still returned the stale copy. Chain
# config and contract addresses live in these files, so a redeploy that doesn't
# reach clients is a correctness problem, not just a staleness one.
# 60s + must-revalidate keeps repeat loads cheap (304 on ETag) while letting a
# publish land within a minute.
/app/app/*
  Cache-Control: public, max-age=60, must-revalidate

/app/components/*
  Cache-Control: public, max-age=60, must-revalidate

# The app's own entry document was the one HTML entry point with NO rule —
# the same 4h-default trap as the modules above, but for the page itself.
/app
  Cache-Control: no-store

/app/
  Cache-Control: no-store

/app/index.html
  Cache-Control: no-store

# Stylesheets and vendor modules ship in lockstep with the app modules above —
# same 60s window, so a publish can never pair new JS with stale CSS or a
# stale ethers. Repeat loads inside the window are cheap 304s on ETag.
/app/styles/*
  Cache-Control: public, max-age=60, must-revalidate

/app/vendor/*
  Cache-Control: public, max-age=60, must-revalidate

# Media never change in place — the -vNN filename suffixes are the bust
# mechanism (v9, v39, …), so a stale-art window is bounded by the next rename.
# Without this rule every badge SVG and card PNG revalidated on every load:
# a cold load was measured issuing ~274 SVG requests against 33 distinct files.
/app/assets/*
  Cache-Control: public, max-age=604800

/app/sounds/*
  Cache-Control: public, max-age=604800

# Trait badge art is frozen by the contract's trait topology; the app also
# ships every badge in one versioned bundle (/app/assets/badge-bundle-vN.json,
# built by db/build-badge-bundle.mjs), so these per-file lanes mostly serve
# first-paint badges and non-app pages.
/badges-circular/*
  Cache-Control: public, max-age=604800

/symbols/*
  Cache-Control: public, max-age=604800
